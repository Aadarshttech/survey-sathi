rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Surveys:
    // - Anyone can read published surveys (to take them as a participant)
    // - Authenticated admins can read surveys they authored (or legacy unassigned surveys)
    // - Authenticated admins can create surveys under their own authorId
    // - Authenticated admins can update or delete only their own surveys
    match /surveys/{surveyId} {
      allow read: if resource.data.status == 'published'
                  || (request.auth != null && (resource.data.authorId == request.auth.uid || !('authorId' in resource.data)));
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || !('authorId' in resource.data));
    }

    // Responses:
    // - Anyone can create a response (participants submitting answers)
    // - Only authenticated admins can read responses
    match /surveys/{surveyId}/responses/{responseId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
  }
}
